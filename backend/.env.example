# Copy this file to .env and fill in your keys
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
# Max PDF pages per file (images = 1). Raise when chunked extract ships.
# MAX_PAGES_PER_FILE=10

# development | production — production refuses in-memory persistence
# APP_ENV=development
# LOG_PAYLOADS=false

# --- LLM (free tier: Groq only) ---
# Get at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Primary model for extraction/planning (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_REFINER_MODEL=llama-3.3-70b-versatile
# GROQ_OWNER_MODEL=llama-3.3-70b-versatile
# Fallback models tried in order when primary fails (API errors, bad JSON, etc.)
# GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b

# --- OpenAI (primary extraction — GPT-4o) ---
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-4o
# OPENAI_FALLBACK_MODELS=gpt-4o-mini

# --- JWT auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_HOURS=72
# DOCUMENT_TOKEN_EXPIRY_MINUTES=15

# --- Usage limits ---
# FREE_PAGE_LIMIT_MONTHLY=50
# MAX_REFINES_PER_RUN=10
# Global pages/day across ALL users (UTC). Keep low while OpenAI credit is small.
# GLOBAL_DAILY_PAGE_LIMIT=100
# Estimated OpenAI $ cap per UTC day (from token usage). 0 = disabled.
# OPENAI_DAILY_BUDGET_USD=1.0
# FREE_EMAIL_LIMIT_MONTHLY=20
# FREE_SHEETS_LIMIT_MONTHLY=20
# ORPHAN_RECLAIM_ON_STARTUP=true
# ORPHAN_RUN_STALE_MINUTES=30

# --- OCR / layout ---
# OCR_ENGINE=rapidocr
# USE_LAYOUT_PRESERVATION=true

# --- Supabase (optional — falls back to in-memory if not set) ---
# Setup guide: docs/SUPABASE_SETUP.md
# 1. Create project at https://supabase.com
# 2. Run supabase/schema.sql in SQL Editor
# 3. Settings → API → Project URL + Secret key (sb_secret_...)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# --- Data persistence (users, workflows, runs) ---
# auto   = Supabase Postgres when SUPABASE_* is set, else in-memory
# memory = always in-memory (local/tests only — blocked when APP_ENV=production)
# supabase = Supabase Postgres (if unset, falls back to memory — also blocked in production)
PERSISTENCE_BACKEND=auto

# --- Auth ---
# email = sign in / register by email lookup (no password)
# supabase = future Supabase Auth provider
AUTH_BACKEND=email
# Passwordless email session — enable only for local/tests. Production: false
AUTH_ALLOW_EMAIL=false
# Google Identity Services — OAuth 2.0 Web client ID (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# --- CORS (comma-separated frontend origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Rate limits (slowapi format) ---
RATE_LIMIT_RUNS_ADHOC=10/minute
RATE_LIMIT_UPLOAD=20/minute
# RATE_LIMIT_EMAIL=5/minute
# RATE_LIMIT_SHEETS=5/minute
# RATE_LIMIT_EXTRACT=10/minute
# RATE_LIMIT_REFINE_PLAN=20/minute
# RATE_LIMIT_PIPELINE=10/minute
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_WAITLIST=5/minute
# RATE_LIMIT_INBOUND=60/minute

# auto     = Supabase Storage when SUPABASE_* is set, else local disk (default)
# local    = always save to UPLOAD_DIR (backend/uploads/)
# supabase = always use Supabase Storage bucket below
DOCUMENT_STORAGE=auto
SUPABASE_DOCUMENTS_BUCKET=documents

# --- User template version payloads (refined templates) ---
# auto     = Supabase Storage when SUPABASE_* is set, else local disk
# local    = backend/uploads/user-templates/
# supabase = Supabase Storage bucket below
# aws_s3   = future AWS S3 swap (set AWS_S3_BUCKET)
USER_TEMPLATE_STORAGE=auto
SUPABASE_USER_TEMPLATES_BUCKET=user-templates
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# ADMIN_API_KEY=

# --- Email delivery (Resend — free tier 3000/month) ---
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Google Sheets (service account) ---
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Job queue (Upstash / Redis — Arq workers) ---
# When set, API enqueues run_id; start worker: arq app.jobs.worker.WorkerSettings
# Empty = local in-process asyncio fallback (no Redis needed)
# REDIS_URL=rediss://default:TOKEN@REGION.upstash.io:6379

# --- Inbound email (Mailgun webhook) ---
# INBOUND_EMAIL_DOMAIN=ingest.nexora.app
# INBOUND_WEBHOOK_SECRET=your_mailgun_signing_key
# Required when using inbound email — empty secret rejects all webhooks.
# INBOUND_WEBHOOK_MAX_AGE_SECONDS=300
# INBOUND_WEBHOOK_TOKEN_TTL_SECONDS=900
